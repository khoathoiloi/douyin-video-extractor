# Project Configuration
PROJECT_NAME="Douyin Content Finder"
VERSION="1.0.0"
DATABASE_URL="sqlite:///./app.db"

# AI Engine (gemini, openai, offline)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Douyin Search (live, mock)
DOUYIN_SEARCH_PROVIDER="live"
DOUYIN_COOKIE=""

# Ranking Weights (Sum = 1.0)
WEIGHT_SEMANTIC=0.35
WEIGHT_VISUAL=0.25
WEIGHT_KEYWORD=0.15
WEIGHT_HASHTAG=0.10
WEIGHT_CONTENT_TYPE=0.10
WEIGHT_POPULARITY=0.05

MAX_VIDEO_SIZE_MB=500
