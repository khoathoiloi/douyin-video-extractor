# ==============================================================================
# Douyin Content Finder - Production Environment Configuration
# ==============================================================================

# Project Details
PROJECT_NAME="Douyin Content Finder API"
VERSION="1.0.0"

# Database Configuration (SQLite file path or PostgreSQL connection string)
DATABASE_URL="sqlite:////app/data/app.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@db:5432/douyin_db"

# Storage Settings
UPLOAD_DIR="/app/uploads"
MAX_VIDEO_SIZE_MB=500

# AI Provider Configuration
# Options: "gemini", "openai", "offline"
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Douyin Search Engine Configuration
# Options: "live" (scrapes Douyin directly), "mock" (offline demo data)
DOUYIN_SEARCH_PROVIDER="live"
DOUYIN_COOKIE=""

# Multi-Layer Ranking Algorithm Weights (Sum must equal 1.0)
WEIGHT_SEMANTIC=0.35
WEIGHT_VISUAL=0.25
WEIGHT_KEYWORD=0.15
WEIGHT_HASHTAG=0.10
WEIGHT_CONTENT_TYPE=0.10
WEIGHT_POPULARITY=0.05

# Domain / Cloud Settings (Optional for SSL / Reverse Proxy)
DOMAIN_NAME=""
ADMIN_EMAIL="admin@example.com"
